# Database (optional — the API itself doesn't require one; db_store.py does)
DATABASE_URL=postgresql://user:pass@localhost/trading

# API settings
DEBUG=False
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=https://your-site.netlify.app

# Push notification alerts (see alerts.py) — generate your own pair with:
#   python generate_vapid.py
# then paste both lines below. The frontend fetches the public key at
# runtime from GET /api/push/vapid-public-key, so it needs no copy of its own.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Identifies you to push services (Chrome/Firefox) — a mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com
# How often (minutes) the background job checks watched tickers for a new signal
ALERT_CHECK_INTERVAL_MINUTES=15

# Paper-trading broker (Alpaca) — powers the Portfolio tab (see broker.py).
# Free signup at https://alpaca.markets, then in the dashboard switch to
# "Paper Trading" (default for new accounts) and generate an API key pair
# there. Paper accounts start with $100,000 in fake cash.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
